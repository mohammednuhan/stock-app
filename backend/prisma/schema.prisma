generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        Int @id @default(autoincrement())
  username  String @unique
  password  String
  orders   Order[]
}

model Stock {
  id      Int @id @default(autoincrement())
  name    String 
  symbol  String @unique
}

model Order {
  id            Int @id @default(autoincrement())
  orderId       Int 
  userId        Int 
  price         Int
  qty           Int
  filledQty     Int
  side          String
  symbol        String
  type          String
  createdAt     DateTime @default(now())

   user      User     @relation(fields: [userId], references: [id])
}

model Fill {
  id          Int @id @default(autoincrement())
  userId      Int
  user        Int
  orderId     Int
  order       String
  price       Int 
  qty         Int
  type        String
  side        String
  createdAt   DateTime @default(now())
}


enum Side {
  BUY
  SELL
}

enum Status {
  FILLED
  CANCELLED
  OPEN
}

enum Type {
  LIMIT
  MARKET
}