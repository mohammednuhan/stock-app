generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        Int @id @default(autoincrement())
  username  String @unique
  password  String
 
  orders   Order[]
  fills    Fill[]
}

model Stock {
  id      Int @id @default(autoincrement())
  name    String 
  symbol  String @unique
}

model Order {
  id            Int @id @default(autoincrement())
  orderId       Int 
  userId        Int 
  price         Int
  qty           Int
  filledQty     Int
  side          String
  symbol        String
  createdAt     DateTime @default(now())

   user      User     @relation(fields: [userId], references: [id])
  fills     Fill[]
}

model Fill {
  id          Int @id @default(autoincrement())
  userId      Int
  orderId     Int
  price       Int 
  qty         Int
  side        Int
  symbol      Int
  createdAt   DateTime @default(now())


  user      User     @relation(fields: [userId], references: [id])
  order     Order    @relation(fields: [orderId], references: [id])
}