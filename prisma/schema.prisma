generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        Int @id @default(autoincrement())
  username  String @unique
  password  String 
}

model Stock {
  id      Int @id @default(autoincrement())
  name    String 
  symbol  String @unique
}

model Order {
  id            Int @id @default(autoincrement())
  stockId       Int 
  userId        Int 
  price         Int
  qty           Int
  filledQty     Int
  createdAt     DateTime @default(now())
}

model Fill {
  id          Int @id @default(autoincrement())
  userId      Int
  orderId     Int
  price       Int 
  qty         Int
  createdAt   DateTime @default(now())
}